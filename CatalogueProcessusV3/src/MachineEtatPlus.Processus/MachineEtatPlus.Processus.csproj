<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Un switch qui oublie une valeur nommée d'un enum ne compile pas. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <!-- Les valeurs non nommées (casts) sont traitées à l'exécution par CatalogueProcessus. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

</Project>
